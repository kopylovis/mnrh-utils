#!/usr/bin/env bash
set -uo pipefail

resolve_root() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")/.." && pwd
}

ROOT=$(resolve_root)
COMMANDS="$ROOT/libexec/mnrh"

describe() {
  case "$1" in
    claude)      echo "запустить Claude Code в одном из проектов (root — в домашнем, sessions — сессии)" ;;
    disk)        echo "что можно почистить на диске (--apply удалить безопасное)" ;;
    init)        echo "первая настройка: папка с проектами и подключение к Claude Code" ;;
    doctor)      echo "проверка системы: диск, память, оболочка, ссылки, автозапуск, безопасность" ;;
    repos)       echo "состояние всех git-проектов в папке проектов (--fetch со свежими данными)" ;;
    sim)         echo "симуляторы: что запущено, stop, clean (--runtimes старые runtime)" ;;
    ram)         echo "кто ест оперативную память, по приложениям (-p по процессам, clean освободить)" ;;
    gradle)      echo "версии Gradle по проектам, кеши, демоны, build/ (clean удалить лишнее)" ;;
    scroll)      echo "перевернуть прокрутку мыши, не трогая трекпад (on, off, test) — вместо Scroll Reverser" ;;
    sleep)       echo "что не даёт Mac уснуть, последние засыпания и пробуждения (fix снять зависшие caffeinate)" ;;
    ssh)         echo "SSH-ключи: состояние; github — выпустить ключ, добавить в GitHub, подпись коммитов" ;;
    ports)       echo "кто слушает TCP-порты: процесс, проект (kill <порт> освободить)" ;;
    uninstall)   echo "удалить приложение вместе с данными в ~/Library (--orphans остатки удалённых)" ;;
    net)         echo "почему не качаются зависимости: сеть, DNS, VPN, прокси, Maven/Google/Gradle/CocoaPods" ;;
    login)       echo "что запускается при входе и в фоне: чьё, подписано ли, работает ли (off убрать)" ;;
    power)       echo "зарядник и сколько даёт, сколько тянет Mac, троттлинг, здоровье батареи" ;;
    defaults)    echo "удобные настройки macOS для разработки с откатом; snap/diff — готовые defaults write" ;;
    outdated)    echo "что пора обновить: macOS, Homebrew, Android Studio и SDK, Gradle в проектах" ;;
    input)       echo "раскладка под приложение: en в среде разработки, остальным — с которой оставил" ;;
    kit)         echo "подборка удобных программ для Mac: что стоит, что нет (install поставить через brew)" ;;
    fix)         echo "быстрые починки без перезагрузки: scroll, dock, finder, wifi, sim, adb, dns, bt, audio…" ;;
    killdaemons) echo "остановить демоны Gradle и Kotlin (-l только показать, -f и занятых)" ;;
    *)           echo "" ;;
  esac
}

available() {
  local f
  for f in "$COMMANDS"/*; do
    [ -f "$f" ] || continue
    f=$(basename "$f")
    echo "${f%.*}"
  done
}

usage() {
  local c
  echo "mnrh $(cat "$ROOT/VERSION" 2>/dev/null) — утилиты для обслуживания Mac"
  echo
  for c in $(available); do
    printf '  mnrh %-14s %s\n' "$c" "$(describe "$c")"
  done
  echo
  echo "  mnrh <команда> -h   справка по команде"
  echo "  mnrh --version      версия"
}

run() {
  local name="$1"; shift
  local f
  for f in "$COMMANDS/$name".*; do
    [ -f "$f" ] || continue
    case "$f" in
      *.py) exec /usr/bin/python3 "$f" "$@" ;;
      *.sh) exec /bin/bash "$f" "$@" ;;
      *)    exec "$f" "$@" ;;
    esac
  done
  echo "mnrh: неизвестная команда «${name}»" >&2
  echo >&2
  usage >&2
  exit 2
}

case "${1:-help}" in
  help|-h|--help) usage ;;
  --version|-v)   cat "$ROOT/VERSION" ;;
  mem)            shift; run ram "$@" ;;
  kd)             shift; run killdaemons "$@" ;;
  *)              cmd="$1"; shift; run "$cmd" "$@" ;;
esac
