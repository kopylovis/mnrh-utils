#!/usr/bin/env bash
set -uo pipefail

resolve_root() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  cd -P "$(dirname "$src")/.." && pwd
}

ROOT=$(resolve_root)
COMMANDS="$ROOT/libexec/mnrh"

REGISTRY="$ROOT/share/mnrh/commands.tsv"

available() {
  local f
  for f in "$COMMANDS"/*; do
    [ -f "$f" ] || continue
    f=$(basename "$f")
    echo "${f%.*}"
  done
}

# Список по группам из share/mnrh/commands.tsv; команд, которых там нет, — в «Другое».
usage() {
  /usr/bin/python3 "$ROOT/libexec/mnrh/lib/launcher.py" help "$REGISTRY" "$(available | tr '\n' ' ')" \
    "$(cat "$ROOT/VERSION" 2>/dev/null)" "${1:-}"
}

run() {
  local name="$1"; shift
  local f
  for f in "$COMMANDS/$name".*; do
    [ -f "$f" ] || continue
    case "$f" in
      *.py) exec /usr/bin/python3 "$f" "$@" ;;
      *.sh) exec /bin/bash "$f" "$@" ;;
      *)    exec "$f" "$@" ;;
    esac
  done
  echo "mnrh: неизвестная команда «${name}»" >&2
  echo >&2
  usage >&2
  exit 2
}

if [ $# -eq 0 ] && [ -t 0 ] && [ -t 1 ] && [ -z "${MNRH_NO_MENU:-}" ]; then
  at=0
  trap 'true' INT
  while true; do
    picked=$(/usr/bin/python3 "$ROOT/libexec/mnrh/lib/launcher.py" menu "$REGISTRY" "$(available | tr '\n' ' ')" "$(cat "$ROOT/VERSION" 2>/dev/null)" "$at") || exit 0
    [ -n "$picked" ] || exit 0
    at=${picked%%$'\t'*}
    choice=${picked#*$'\t'}
    printf '\033[2m$ mnrh %s\033[0m\n' "$choice"
    ( eval "set -- $choice"; "$0" "$@" )
    /usr/bin/python3 "$ROOT/libexec/mnrh/lib/launcher.py" after "$?" || exit 0
  done
fi

case "${1:-help}" in
  help|-h|--help) [ "${2:-}" = "-a" ] && usage all || usage ;;
  --version|-v)   cat "$ROOT/VERSION" ;;
  mem)            shift; run ram "$@" ;;
  kd)             shift; run killdaemons "$@" ;;
  *)              cmd="$1"; shift; run "$cmd" "$@" ;;
esac
